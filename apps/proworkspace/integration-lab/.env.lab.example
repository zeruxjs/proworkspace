ZX_TEST_PG_HOST=127.0.0.1
ZX_TEST_PG_PORT=55432
ZX_TEST_MYSQL_HOST=127.0.0.1
ZX_TEST_MYSQL_PORT=53306
ZX_TEST_MYSQL_USER=lab
ZX_TEST_MYSQL_PASSWORD=lab_only_not_production
ZX_TEST_MYSQL_DB=zerux_lab
ZX_TEST_MONGO_URI=mongodb://127.0.0.1:57017
ZX_TEST_MONGO_HOST=127.0.0.1
ZX_TEST_MONGO_PORT=57017
ZX_TEST_MONGO_DB=zerux_lab
LAB_REDIS_HOST=127.0.0.1
LAB_REDIS_PORT=56379
CACHE_REDIS_URL=redis://127.0.0.1:56379
QUEUE_REDIS_URL=redis://127.0.0.1:56379
LAB_S3_HOST=127.0.0.1
LAB_S3_PORT=59000
LAB_S3_ENDPOINT=http://127.0.0.1:59000
LAB_S3_BUCKET=zerux-lab
LAB_S3_EPHEMERAL_BUCKET=1
LAB_S3_REGION=us-east-1
LAB_S3_ACCESS_KEY=minio_lab_only
LAB_S3_SECRET_KEY=minio_lab_secret_only
